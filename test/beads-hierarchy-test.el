;;; beads-hierarchy-test.el --- Tests for beads-hierarchy -*- lexical-binding: t -*-

;;; Code:

(require 'ert)
(require 'hierarchy)
(require 'beads-hierarchy)

(defvar beads-hierarchy-test--mock-issues
  (let ((h (make-hash-table :test 'equal)))
    (puthash "ROOT-1"
             '((id . "ROOT-1")
               (title . "Root issue")
               (status . "open")
               (priority . 1)
               (issue_type . "epic")
               (dependents . [((id . "CHILD-1")
                               (title . "Child one")
                               (status . "open")
                               (dependency_type . "parent-child"))
                              ((id . "CHILD-2")
                               (title . "Child two")
                               (status . "closed")
                               (dependency_type . "parent-child"))]))
             h)
    (puthash "CHILD-1"
             '((id . "CHILD-1")
               (title . "Child one")
               (status . "open")
               (priority . 2)
               (issue_type . "task")
               (dependencies . [((id . "ROOT-1")
                                 (title . "Root issue")
                                 (dependency_type . "parent-child"))])
               (dependents . [((id . "GRANDCHILD-1")
                               (title . "Grandchild")
                               (status . "in_progress")
                               (dependency_type . "parent-child"))]))
             h)
    (puthash "CHILD-2"
             '((id . "CHILD-2")
               (title . "Child two")
               (status . "closed")
               (priority . 2)
               (issue_type . "task")
               (dependencies . [((id . "ROOT-1")
                                 (title . "Root issue")
                                 (dependency_type . "parent-child"))])
               (dependents . nil))
             h)
    (puthash "GRANDCHILD-1"
             '((id . "GRANDCHILD-1")
               (title . "Grandchild")
               (status . "in_progress")
               (priority . 3)
               (issue_type . "task")
               (dependencies . [((id . "CHILD-1")
                                 (title . "Child one")
                                 (dependency_type . "parent-child"))])
               (dependents . nil))
             h)
    (puthash "LONE-1"
             '((id . "LONE-1")
               (title . "Lone issue")
               (status . "open")
               (priority . 2)
               (issue_type . "task")
               (dependencies . nil)
               (dependents . nil))
             h)
    h)
  "Mock issue data for testing.")

(ert-deftest beads-hierarchy-test-build-related-issues ()
  "Build ancestors and descendants from one snapshot, retaining closed issues."
  (let* ((issues (hash-table-values beads-hierarchy-test--mock-issues))
         (result (beads-hierarchy--build "CHILD-1" issues))
         (h (car result))
         (by-id (cdr result)))
    (should (= 3 (hierarchy-length h)))
    (should (gethash "ROOT-1" by-id))
    (should (gethash "CHILD-1" by-id))
    (should (gethash "GRANDCHILD-1" by-id))
    (should-not (gethash "CHILD-2" by-id))
    (should-not (gethash "LONE-1" by-id))
    (should (equal (mapcar (lambda (issue) (alist-get 'id issue)) (hierarchy-roots h))
                   '("ROOT-1")))
    (let ((children (cdr (beads-hierarchy--build "ROOT-1" issues))))
      (should (= 4 (hash-table-count children)))
      (should (equal (alist-get 'status (gethash "CHILD-2" children)) "closed")))))

(ert-deftest beads-hierarchy-test-build-current-cli-relations ()
  "Understand current bd dependency records and standalone parent fields."
  (let* ((issues '(((id . "root"))
                   ((id . "child") (parent . "root")
                    (dependencies . [((depends_on_id . "root") (type . "parent-child"))]))
                   ((id . "leaf") (parent . "child"))
                   ((id . "blocked") (dependencies . [((depends_on_id . "child") (type . "blocks"))]))
                   ((id . "unrelated"))))
         (result (beads-hierarchy--build "child" issues)))
    (should (= 4 (hierarchy-length (car result))))
    (should (= 4 (hash-table-count (cdr result))))
    (should-not (gethash "unrelated" (cdr result)))))

(ert-deftest beads-hierarchy-test-build-shared-dependencies-and-cycle ()
  "Cycles, missing targets and shared blockers must terminate without duplication."
  (let* ((issues '(((id . "root") (dependencies . [((id . "a")) ((id . "b"))]))
                   ((id . "a") (dependencies . [((id . "shared"))]))
                   ((id . "b") (dependencies . [((id . "shared"))]))
                   ((id . "shared") (dependencies . [((id . "root")) ((id . "missing"))]))))
         (result (beads-hierarchy--build "root" issues)))
    (should (= 4 (hierarchy-length (car result))))
    (should (= 4 (hash-table-count (cdr result))))
    (should (hierarchy-roots (car result)))))

(ert-deftest beads-hierarchy-test-render-all-branches-expanded ()
  "Every collected issue is visible, including additional ancestor roots."
  (let ((issues '(((id . "focus") (title . "Focus") (priority . 2) (status . "open")
                   (dependencies . [((id . "first")) ((id . "second"))]))
                  ((id . "first") (title . "First") (priority . 2) (status . "open"))
                  ((id . "second") (title . "Second") (priority . 2) (status . "open"))
                  ((id . "leaf.1") (title . "Leaf") (priority . 2) (status . "open") (parent . "focus")))))
    (with-temp-buffer
      (beads-hierarchy-mode)
      (beads-hierarchy--render "focus" issues)
      (dolist (id '("focus" "first" "second" "leaf.1"))
        (should (string-match-p (regexp-quote id) (buffer-string)))))))

(ert-deftest beads-hierarchy-test-build-lone-and-missing-issue ()
  "A lone issue is still displayed; an unknown focus is reported."
  (let ((issues (hash-table-values beads-hierarchy-test--mock-issues)))
    (should (= 1 (hierarchy-length (car (beads-hierarchy--build "LONE-1" issues)))))
    (should-error (beads-hierarchy--build "missing" issues) :type 'beads-client-error)))

(ert-deftest beads-hierarchy-test-async-refresh-workspace-and-obsolete-results ()
  "Fetch once per refresh without blocking, ignoring results from older requests."
  (let ((directory temporary-file-directory)
        (buffer-name "*Beads Deps: ROOT-1*")
        callbacks)
    (unwind-protect
        (save-window-excursion
          (cl-letf (((symbol-function 'beads-client-request-async)
                     (lambda (operation args callback)
                       (should (equal operation "list"))
                       (should-not args)
                       (push callback callbacks)
                       nil))
                    ((symbol-function 'beads-client-show)
                     (lambda (&rest _) (ert-fail "Unexpected per-issue CLI fetch"))))
            (let ((default-directory directory))
              (beads-hierarchy-show "ROOT-1"))
            (should-not beads-hierarchy--hierarchy)
            (beads-hierarchy-refresh)
            (should (= 2 (length callbacks)))
            (funcall (cadr callbacks) (hash-table-values beads-hierarchy-test--mock-issues) nil)
            (should-not beads-hierarchy--hierarchy)
            (funcall (car callbacks) (hash-table-values beads-hierarchy-test--mock-issues) nil)
            (should (= 4 (hash-table-count beads-hierarchy--by-id)))
            (should (equal default-directory directory))
            (should (equal beads-hierarchy--root-id "ROOT-1"))
            (should-not beads-hierarchy--refresh-process)))
      (when-let ((buffer (get-buffer buffer-name))) (kill-buffer buffer)))))

(provide 'beads-hierarchy-test)
;;; beads-hierarchy-test.el ends here
